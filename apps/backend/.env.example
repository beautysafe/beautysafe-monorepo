FIREBASE_STORAGE_BUCKET=beautysafe-35ec7.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/firebase-service-account.json
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=beautysafe
# Production-safe defaults. Run migrations explicitly with pnpm migration:run.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
JWT_SECRET=replace-with-a-long-random-secret
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-gmail-address@example.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_NAME=BeautySafe
PASSWORD_RESET_SECRET=replace-with-an-independent-long-random-secret
# Used only by `pnpm mail:test`.
MAIL_TEST_TO=recipient@example.com
